e(basePos.below()).getCollisionShape(level, basePos.below()).isEmpty()) return false;

        Vec3 pivot = new Vec3(basePos.getX() + 0.5D, basePos.getY(), basePos.getZ() + 0.5D);
        double minDistance = VolcanoProfile.MIN_SPAWN_DISTANCE * STUD_TO_BLOCK;
        for (Tree other : TREES.values()) {
            if (other.level == level && other.pivot.distanceTo(pivot) < minDistance) return false;
        }

        ArmorStand root = EntityType.ARMOR_STAND.create(level);
        if (root == null) return false;
        root.setPos(pivot.x, pivot.y, pivot.z);
        root.setInvisible(true);
        root.setNoGravity(true);
        root.setInvulnerable(true);
        root.setSilent(true);
        root.addTag(ROOT_TAG);
        CompoundTag rootTag = new CompoundTag();
        root.saveWithoutId(rootTag);
        rootTag.putBoolean("Marker", true);
        rootTag.putBoolean("Invisible", true);
        rootTag.putBoolean("NoGravity", true);
        rootTag.putBoolean("Invulnerable", true);
        root.load(rootTag);
        root.setPos(pivot.x, pivot.y, pivot.z);
        if (!level.addFreshEntity(root)) return false;

        long seed = level.getRandom().nextLong();
        Simulation sim = new Simulation(seed, level, pivot);
        Tree tree = new Tree(level, root, seed, sim, sim.initialInterval);
        TREES.put(root.getUUID(), tree);
        tree.writeMeta();
        tree.rebuildEntities();
        return true;
    }

    private static void bootstrap(ServerLevel level) {
        List<ArmorStand> roots = new ArrayList<>();
        for (Entity entity : level.getAllEntities()) {
            if (entity instanceof ArmorStand stand && stand.getTags().contains(ROOT_TAG)) roots.add(stand);
        }
        for (ArmorStand root : roots) {
            if (TREES.containsKey(root.getUUID())) continue;
            Long seed = longTagNullable(root, SEED_PREFIX);
            if (seed == null) continue;
            int growCalls = intTag(root, GROW_PREFIX, 0);
            double ttg = doubleTag(root, TTG_PREFIX, 10.0D);
            Simulation sim = new Simulation(seed, level, root.position());
            for (int i = 0; i < growCalls && !sim.finished; i++) {
                sim.grow();
                sim.drawNextInterval();
            }
            Tree tree = new Tree(level, root, seed, sim, ttg);
            tree.state = enumTag(root, STATE_PREFIX, TreeState.GROWING);
            tree.fallAngle = doubleTag(root, FALL_ANGLE_PREFIX, 0.0D);
            tree.fallYaw = doubleTag(root, FALL_YAW_PREFIX, 0.0D);
            tree.freeFall = boolTag(root, FREE_FALL_PREFIX, false);
            String carrier = stringTag(root, CARRIER_PREFIX);
            if (carrier != null) {
                try { tree.carriedBy = UUID.fromString(carrier); } catch (IllegalArgumentException ignored) {}
            }
            tree.pivot = root.position();
            TREES.put(root.getUUID(), tree);
            tree.removeChildren();
            tree.rebuildEntities();
        }
    }

    private static Tree treeFromEntity(Entity entity) {
        if (entity.getTags().contains(ROOT_TAG)) return TREES.get(entity.getUUID());
        String owner = stringTag(entity, OWNER_PREFIX);
        if (owner == null) return null;
        try { return TREES.get(UUID.fromString(owner)); }
        catch (IllegalArgumentException ignored) { return null; }
    }

