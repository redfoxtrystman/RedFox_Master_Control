h = Math.max(Math.abs(a.x - b.x), Math.abs(a.z - b.z)) + thick;
            double minY = Math.min(a.y, b.y) - thick * 0.5D;
            double maxY = Math.max(a.y, b.y) + thick * 0.5D;
            double height = Math.max(0.35D, maxY - minY);
            CompoundTag tag = new CompoundTag();
            hit.saveWithoutId(tag);
            tag.putFloat("width", (float)Math.max(0.35D, width));
            tag.putFloat("height", (float)height);
            tag.putBoolean("response", true);
            hit.load(tag);
            hit.setPos((a.x + b.x) * 0.5D, minY, (a.z + b.z) * 0.5D);
        }

        Quaternionf bodyRotation() { return bodyRotation(fallAngle); }

        Quaternionf bodyRotation(double angle) {
            if (angle == 0.0D) return new Quaternionf();
            float ax = (float)Math.sin(fallYaw);
            float az = (float)-Math.cos(fallYaw);
            return new Quaternionf().fromAxisAngleRad(ax, 0.0F, az, (float)angle);
        }

        Vec3 transformPoint(Vec3 studs, Quaternionf body, Vec3 candidatePivot) {
            Vec3 scaled = studs.scale(STUD_TO_BLOCK);
            return candidatePivot.add(rotated(body, scaled));
        }

        void writeMeta() {
            putSingleTag(controller, SEED_PREFIX, Long.toString(seed));
            putSingleTag(controller, GROW_PREFIX, Integer.toString(sim.growCalls));
            putSingleTag(controller, TTG_PREFIX, String.format(Locale.ROOT, "%.6f", timeToNextGrow));
            putSingleTag(controller, STATE_PREFIX, state.name());
            putSingleTag(controller, FALL_ANGLE_PREFIX, String.format(Locale.ROOT, "%.8f", fallAngle));
            putSingleTag(controller, FALL_YAW_PREFIX, String.format(Locale.ROOT, "%.8f", fallYaw));
            putSingleTag(controller, FREE_FALL_PREFIX, Boolean.toString(freeFall));
            if (carriedBy != null) putSingleTag(controller, CARRIER_PREFIX, carriedBy.toString());
            else removePrefixTags(controller, CARRIER_PREFIX);
        }
