diff --git a/PKVault.Core/storage/data-action/MoveMoneyAction.cs b/PKVault.Core/storage/data-action/MoveMoneyAction.cs
new file mode 100644
index 0000000..6ee502d
--- /dev/null
+++ b/PKVault.Core/storage/data-action/MoveMoneyAction.cs
@@ -0,0 +1,20 @@
+namespace PKVault.Core;
+
+public class MoveMoneyAction(ItemBankService itemBankService) : DataAction<MoveMoneyActionInput>
+{
+    protected override async Task<DataActionPayload> Execute(MoveMoneyActionInput input, DataUpdateFlags flags)
+    {
+        var result = await itemBankService.MoveMoney(input);
+        flags.SaveInfos = true;
+
+        return new(
+            type: DataActionType.MOVE_ITEM,
+            parameters: [
+                "Pokédollars",
+                result.Direction == "deposit" ? result.Version : null,
+                result.Direction == "withdraw" ? result.Version : null,
+                result.MovedAmount,
+            ]
+        );
+    }
+}
