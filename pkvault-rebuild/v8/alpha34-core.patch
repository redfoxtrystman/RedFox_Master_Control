+    private static void PatchDexArray(
+        RubyObject trainer,
+        string key,
+        IReadOnlySet<int> enabledSpecies)
+    {
+        var values = RubyValue.Array(Get(trainer, key));
+        if (values == null)
+            return;
+
+        var max = enabledSpecies.Count == 0 ? 0 : enabledSpecies.Max();
+        while (values.Items.Count <= max)
+            values.Items.Add(false);
+
+        foreach (var species in enabledSpecies.Where(x => x > 0))
+            values.Items[species] = true;
+    }
+
+    private static void PatchBag(
+        RubyObject bag,
+        IReadOnlyList<EssentialsBagPocketData> pockets)
+    {
+        var values = RubyValue.Array(Get(bag, "@pockets"))
+            ?? throw new InvalidDataException("PokemonBag @pockets array not found.");
+
+        foreach (var pocket in pockets)
+        {
+            while (values.Items.Count <= pocket.PocketIndex)
+                values.Items.Add(new RubyArray());
+
+            var rawPocket = RubyValue.Array(values.Items[pocket.PocketIndex]);
+            if (rawPocket == null)
+            {
+                rawPocket = new RubyArray();
+                values.Items[pocket.PocketIndex] = rawPocket;
+            }
+
+            rawPocket.Items.Clear();
+            foreach (var item in pocket.Items.Where(x => x.ItemId > 0 && x.Count > 0))
+            {
+                var pair = new RubyArray();
+                pair.Items.Add((long)item.ItemId);
+                pair.Items.Add((long)item.Count);
+                rawPocket.Items.Add(pair);
+            }
+        }
+    }
