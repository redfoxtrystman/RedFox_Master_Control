+    public async Task<long> GetBankItemCount(string itemKey)
+    {
+        if (string.IsNullOrWhiteSpace(itemKey))
+            return 0;
+
+        var bank = await LoadBankState();
+        return bank.Values
+            .Where(stack => AreEquivalentItemKeys(stack.ItemKey, itemKey))
+            .Sum(stack => stack.Count);
+    }
+
+    public async Task ConsumeBankItem(string itemKey, long count = 1)
+    {
+        if (string.IsNullOrWhiteSpace(itemKey))
+            throw new ArgumentException("Evolution item key cannot be empty.", nameof(itemKey));
+        if (count <= 0)
+            throw new ArgumentOutOfRangeException(nameof(count));
+
+        var bank = await LoadBankState();
+        var candidates = bank
+            .Where(entry => AreEquivalentItemKeys(entry.Value.ItemKey, itemKey))
+            .OrderBy(entry => entry.Value.Page)
+            .ThenBy(entry => entry.Value.Slot)
+            .Select(entry => entry.Key)
+            .ToList();
+
+        var available = candidates.Sum(key => bank[key].Count);
+        if (available < count)
+            throw new InvalidOperationException(`PKVault Item Bank needs ${count:N0} × ${itemKey}, but only has ${available:N0}.`);
+
+        var remaining = count;
+        foreach (var key in candidates)
+        {
+            if (remaining <= 0)
+                break;
+
+            var stack = bank[key];
+            var take = Math.Min(stack.Count, remaining);
+            var left = stack.Count - take;
+            remaining -= take;
+
+            if (left <= 0)
+            {
+                bank.Remove(key);
+            }
+            else
+            {
+                bank[key] = stack with
+                {
+                    Count = left,
+                    Origins = RemoveOrigins(stack.Origins, take),
+                };
+            }
+        }
+
+        await SaveBankState(bank);
+    }
+
     public async Task<long> GetMoneyBankBalance()
         => await LoadMoneyBank();
 
