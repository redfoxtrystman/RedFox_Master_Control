+    private static List<EssentialsBagPocketData> ReadBagPockets(RubyObject? bag)
+    {
+        var result = new List<EssentialsBagPocketData>();
+        var rawPockets = bag == null ? null : RubyValue.Array(Get(bag, "@pockets"));
+        if (rawPockets == null)
+            return result;
+
+        for (var pocketIndex = 1; pocketIndex < rawPockets.Items.Count; pocketIndex++)
+        {
+            var rawPocket = RubyValue.Array(rawPockets.Items[pocketIndex]);
+            if (rawPocket == null)
+                continue;
+
+            var items = new List<EssentialsBagSlotData>();
+            foreach (var rawSlotValue in rawPocket.Items)
+            {
+                var rawSlot = RubyValue.Array(rawSlotValue);
+                if (rawSlot == null || rawSlot.Items.Count < 2)
+                    continue;
+
+                var itemId = checked((int)RubyValue.Int(rawSlot.Items[0], 0));
+                var count = checked((int)RubyValue.Int(rawSlot.Items[1], 0));
+                if (itemId > 0 && count > 0)
+                    items.Add(new(itemId, count));
+            }
+
+            result.Add(new(
+                PocketIndex: pocketIndex,
+                Label: GetLegacyPocketLabel(pocketIndex),
+                Items: items
+            ));
+        }
+
+        return result;
+    }
+
+    private static HashSet<int> ReadDexSet(object? value)
+    {
+        var result = new HashSet<int>();
+        var values = RubyValue.Array(value);
+        if (values == null)
+            return result;
+
+        for (var species = 1; species < values.Items.Count; species++)
+        {
+            var entry = values.Items[species];
+            var enabled = entry switch
+            {
+                bool b => b,
+                int i => i != 0,
+                long l => l != 0,
+                _ => entry != null,
+            };
+            if (enabled)
+                result.Add(species);
+        }
+
+        return result;
+    }
+
